# 复制到部署机的 nginx/sites-enabled/ 改名 xxx.conf 生效
# nginx/sites-enabled 已在 http 上下文内，map 可以放这里

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# tailnet 内置 DNS，TUN 模式下可达
resolver 100.100.100.100 valid=30s ipv6=off;

server {
    listen 443 ssl;
    server_name nas.example.com;

    ssl_certificate     /etc/nginx/ssl/nas.crt;
    ssl_certificate_key /etc/nginx/ssl/nas.key;

    location / {
        # 变量形式：运行时解析，上游离线也不会导致 nginx 起不来
        set $target "nas.tailxxxxx.ts.net:8080";
        proxy_pass http://$target;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}

server {
    listen 80;
    server_name nas.example.com;
    return 301 https://$host$request_uri;
}
