# 实例标识：决定 compose 项目名、容器名、卷名前缀
# 同一台机器跑多份时，每份用不同的值
INSTANCE=reuse-server

# 镜像：留空用本地 reuse-server:trixie
# 部署机示例：IMAGE=<registry>/<repo>:<tag>
IMAGE=

# tailnet 里显示的设备名；留空等于 INSTANCE
TS_HOSTNAME=

# 网络模式：false=TUN（可反代其他 TS 机器），true=userspace（仅入站）
TS_USERSPACE=false

# 使用 tailnet DNS（MagicDNS）
TS_ACCEPT_DNS=true

# 留空 = 复用卷里的登录态；首次也可留空走日志链接
TS_AUTHKEY=

# 站点配置与证书目录（多实例时各自指定）
SITES_DIR=./nginx/sites-enabled
SSL_DIR=./nginx/ssl
